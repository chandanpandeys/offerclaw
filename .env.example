# Server-side only. Never prefix these with VITE_ or expose them to browser code.

# Primary direct AI provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Optional resilience layer. AI Gateway is used when direct Gemini is unavailable,
# or as the primary provider when GEMINI_API_KEY is not set. On Vercel, an OIDC
# token can also satisfy Gateway authentication when configured by the platform.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-3.7-flash
AI_GATEWAY_FALLBACK_MODELS=
AI_GATEWAY_PROVIDER_ORDER=
AI_GATEWAY_ZDR=true

# Aggregated live job feed.
JSEARCH_API_KEY=

# Optional official/public ATS feeds. These are read-only public job-board APIs;
# no applicant or employer credentials are used. Configure up to six sources.
#
# Compact syntax:
# PUBLIC_ATS_SOURCES=greenhouse:openai=OpenAI;lever:leverdemo=Lever;ashby:example=Example
#
# JSON syntax is also supported:
# PUBLIC_ATS_SOURCES=[{"provider":"greenhouse","site":"openai","label":"OpenAI"}]
#
# Supported providers: greenhouse, lever, lever_eu, ashby
PUBLIC_ATS_SOURCES=

# Optional dedicated remote browser worker. The OfferClaw web runtime currently
# exposes only the inspection gateway. The worker URL must be HTTPS and the bearer
# token stays server-side. Do not point this at a general-purpose browser-control API.
BROWSER_WORKER_URL=
BROWSER_WORKER_TOKEN=
BROWSER_WORKER_TIMEOUT_MS=20000

# Anonymous device identity boundary for durable per-device state.
# Generate a high-entropy value (at least 32 characters; 32+ random bytes recommended).
# The signed token contains only a random device subject and timestamps, never profile,
# resume, job-search, or application data. Keep this server-side and rotate deliberately.
OFFERCLAW_IDENTITY_SECRET=

# Optional Upstash Redis REST store for device-scoped scout goals + compact run history.
# These credentials remain server-side. OfferClaw derives Redis keys only from a verified
# HttpOnly device session; the browser never supplies a device subject or storage key.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_TIMEOUT_MS=5000

# Local-development escape hatch only. Production/Vercel cookies are Secure by default.
# IDENTITY_COOKIE_SECURE=false
